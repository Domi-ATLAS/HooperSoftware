        <button><img src="static/images/atl.png" alt="Imagen 13"></button>
        <button><img src="static/images/orlando.png" alt="Imagen 14"></button>
        <button><img src="static/images/heats.png" alt="Imagen 15"></button>
        <button><img src="static/images/kings.png" alt="Imagen 16"></button>
        <button><img src="static/images/goldenstate.jpg" alt="Imagen 17"></button>
        <button><img src="static/images/clippers.png" alt="Imagen 18"></button>
        <button><img src="static/images/lakers.png" alt="Imagen 19"></button>
